{
  "name": "@frametell/agent",
  "version": "0.1.0",
  "description": "The Frametell director: staged agent runs (storyboard, narration script, pages, review) on Pi, the Claude Agent SDK or the Codex SDK, with lint and frame checks enforced by the orchestrator.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@frametell/engine": "workspace:*",
    "@frametell/models": "workspace:*",
    "@frametell/voice": "workspace:*",
    "@openai/codex-sdk": "0.162.1",
    "typebox": "^1.3.36"
  }
}
